{
  "name": "@kapula/driver",
  "version": "0.1.0-alpha.1",
  "description": "Typed Kapula driver HTTP and WebSocket client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/porrasm/kapula.git",
    "directory": "packages/driver"
  },
  "homepage": "https://github.com/porrasm/kapula#readme",
  "bugs": "https://github.com/porrasm/kapula/issues",
  "keywords": [
    "kapula",
    "controller",
    "gamepad",
    "phone",
    "websocket",
    "express"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kapula/protocol": "0.1.0-alpha.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  }
}
