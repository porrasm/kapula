{
  "name": "@kapula/protocol",
  "version": "0.1.0-alpha.1",
  "description": "Kapula wire protocol: zod schemas, constants and types shared by the server, the phone UI and drivers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/porrasm/kapula.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/porrasm/kapula#readme",
  "bugs": "https://github.com/porrasm/kapula/issues",
  "keywords": [
    "kapula",
    "controller",
    "gamepad",
    "phone",
    "websocket",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
